// Fused Rotation + MXFP4 Quantization HIP Kernel with MFMA
//
// Uses v_mfma_f32_16x16x32_bf16 for rotation matmul
// Uses v_cvt_scalef32_pk_fp4_f32 for fp4 quantization
// Direct global store for shuffled/raw scales
//
// Target: MI355X (gfx950, CDNA4)

#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>
#include <torch/extension.h>
#include <ATen/hip/HIPContext.h>

// Constants
constexpr int RS = 128;           // rotation size
constexpr int QG = 32;            // quant group size
constexpr int NUM_QG = RS / QG;   // 4 quant groups per rotation block
constexpr int BLOCK_M = 32;       // rows per CTA
constexpr int WAVEFRONT = 64;     // AMD wavefront size
constexpr int NUM_WAVES = 4;      // wavefronts per CTA
constexpr int THREADS = NUM_WAVES * WAVEFRONT; // 256

// fp4 scale calculation matching HIP ASM (fp4_scale with 0x400000 carry)
__device__ __forceinline__ float fp4_scale_func(float absMax) {
    uint32_t u32 = __float_as_uint(absMax);
    uint32_t exponent = (u32 >> 23) & 0xFF;
    if (exponent == 0xFF) return __uint_as_float(exponent << 23);
    if ((u32 & 0x400000) && ((u32 & 0x200000) || (u32 & 0x1FFFFF) || exponent))
        exponent += 1;
    return __uint_as_float(exponent << 23);
}

// Shuffle index for e8m0 scales
__device__ __forceinline__ int shuffle_scale_idx(int sn_pad, int m_local, int col) {
    int i1 = m_local / 16;
    int i2 = m_local % 16;
    int i3 = col / 8;
    int i4 = (col % 8) / 4;
    int i5 = col % 4;
    int flat = i3 * 256 + i5 * 64 + i2 * 4 + i4 * 2 + i1;
    return (flat / sn_pad) * sn_pad + (flat % sn_pad);
    // Note: the actual store offset is (flat/sn_pad + m_base) * stride + flat%sn_pad
}

__global__ void fused_rotation_quant_mfma_kernel(
    uint8_t* __restrict__ out_fp4,       // [M, K/2]
    uint8_t* __restrict__ out_scale,     // [sm_pad, sn_pad] or [M, K/32]
    const __bf16* __restrict__ x,        // [M, K] bf16
    const __bf16* __restrict__ rot,      // [RS, RS] bf16
    int M, int K,
    int stride_x_m,                      // K
    int stride_fp4_m,                    // K/2
    int stride_sc_m,                     // sn_padded
    int sn_padded,
    int shuffle_scales                   // 0 or 1
) {
    int block_m = blockIdx.x;
    int block_rot = blockIdx.y;
    int tid = threadIdx.x;
    int wave_id = tid / WAVEFRONT;
    int lane_id = tid % WAVEFRONT;

    int m_base = block_m * BLOCK_M;
    int col_base = block_rot * RS;

    // ======== Load rotation matrix to LDS ========
    __shared__ __bf16 R_lds[RS][RS]; // 32KB

    for (int i = tid; i < RS * RS; i += THREADS) {
        int r = i / RS;
        int c = i % RS;
        R_lds[r][c] = rot[r * RS + c];
    }
    __syncthreads();

    // ======== Each thread computes its assigned output elements ========
    // Simple approach: each thread handles multiple (m, k) output positions
    // 256 threads, 32*128 = 4096 output elements → 16 elements per thread
    // Use bf16 accumulation to match torch matmul

    // Thread mapping: thread tid handles elements at stride THREADS
    float acc[16]; // each thread accumulates 16 output elements
    
    for (int i = 0; i < 16; i++) {
        int flat_idx = tid + i * THREADS;
        int m_local = flat_idx / RS;  // 0..31
        int k_out = flat_idx % RS;    // 0..127
        
        if (m_local >= BLOCK_M) { acc[i] = 0.0f; continue; }
        int global_m = m_base + m_local;
        if (global_m >= M) { acc[i] = 0.0f; continue; }
        
        // Dot product: x[global_m, col_base:col_base+RS] · R[:, k_out]
        float sum = 0.0f;
        const __bf16* x_row = x + global_m * stride_x_m + col_base;
        
        for (int j = 0; j < RS; j += 4) {
            // Load x and R as bf16, multiply as fp32, accumulate
            float x0 = __bfloat162float(x_row[j]);
            float x1 = __bfloat162float(x_row[j+1]);
            float x2 = __bfloat162float(x_row[j+2]);
            float x3 = __bfloat162float(x_row[j+3]);
            
            float r0 = __bfloat162float(R_lds[j][k_out]);
            float r1 = __bfloat162float(R_lds[j+1][k_out]);
            float r2 = __bfloat162float(R_lds[j+2][k_out]);
            float r3 = __bfloat162float(R_lds[j+3][k_out]);
            
            sum += x0 * r0 + x1 * r1 + x2 * r2 + x3 * r3;
        }
        // Truncate to bf16 to match torch matmul precision
        sum = __bfloat162float(__float2bfloat16(sum));
        acc[i] = sum;
    }

    // ======== Quantization ========
    // Each quant group has QG=32 consecutive elements
    // Need to find amax per group, compute e8m0, then v_cvt_fp4
    
    // Shared memory for per-group amax reduction
    __shared__ float group_amax[BLOCK_M][NUM_QG]; // 32*4*4 = 512B
    __shared__ uint8_t group_e8m0[BLOCK_M][NUM_QG]; // 128B
    __shared__ float group_scale[BLOCK_M][NUM_QG]; // 512B

    // Step 1: Each thread contributes its elements' abs values to group amax
    // Initialize
    if (tid < BLOCK_M * NUM_QG) {
        group_amax[tid / NUM_QG][tid % NUM_QG] = 0.0f;
    }
    __syncthreads();

    for (int i = 0; i < 16; i++) {
        int flat_idx = tid + i * THREADS;
        int m_local = flat_idx / RS;
        int k_out = flat_idx % RS;
        if (m_local >= BLOCK_M) continue;
        
        int qg_idx = k_out / QG;
        atomicMax((int*)&group_amax[m_local][qg_idx], __float_as_int(fabsf(acc[i])));
    }
    __syncthreads();

    // Step 2: Compute e8m0 and scale
    if (tid < BLOCK_M * NUM_QG) {
        int m_local = tid / NUM_QG;
        int qg = tid % NUM_QG;
        float amax = __int_as_float(*(int*)&group_amax[m_local][qg]);
        
        float scale = fp4_scale_func(amax) * 0.25f; // inverted_scale
        uint8_t e8m0 = (__float_as_uint(scale) >> 23) & 0xFF;
        
        group_e8m0[m_local][qg] = e8m0;
        group_scale[m_local][qg] = scale;
    }
    __syncthreads();

    // Step 3: v_cvt_scalef32_pk_fp4_f32 for each pair of elements
    for (int i = 0; i < 16; i += 2) {
        int flat0 = tid + i * THREADS;
        int flat1 = tid + (i+1) * THREADS;
        int m0 = flat0 / RS, k0 = flat0 % RS;
        int m1 = flat1 / RS, k1 = flat1 % RS;
        
        if (m0 >= BLOCK_M || m_base + m0 >= M) continue;
        if (k0 % 2 != 0) continue; // must be even-odd pair in same byte
        
        // Get scale for this pair
        float scale = group_scale[m0][k0 / QG];
        
        // v_cvt_scalef32_pk_fp4_f32: pack 2 fp32 → 1 byte fp4x2
        uint32_t packed;
        asm volatile("v_cvt_scalef32_pk_fp4_f32 %0, %1, %2, %3"
                     : "=v"(packed) : "v"(acc[i]), "v"(acc[i+1]), "v"(scale));
        
        // Store packed fp4
        int fp4_col = k0 / 2;
        int global_m = m_base + m0;
        out_fp4[global_m * stride_fp4_m + block_rot * (RS/2) + fp4_col] = (uint8_t)packed;
    }

    // Step 4: Store scales
    if (tid < BLOCK_M * NUM_QG) {
        int m_local = tid / NUM_QG;
        int qg = tid % NUM_QG;
        int global_m = m_base + m_local;
        
        if (global_m >= M && !shuffle_scales) return;
        
        uint8_t e8m0_val = (global_m < M) ? group_e8m0[m_local][qg] : 0;
        int orig_col = block_rot * NUM_QG + qg;
        
        if (shuffle_scales) {
            int flat = shuffle_scale_idx(sn_padded, m_local, orig_col);
            int sh_row = flat / sn_padded + m_base;
            int sh_col = flat % sn_padded;
            if (sh_row < m_base + BLOCK_M) {
                out_scale[sh_row * stride_sc_m + sh_col] = e8m0_val;
            }
        } else {
            if (global_m < M) {
                out_scale[global_m * stride_sc_m + orig_col] = e8m0_val;
            }
        }
    }
}

// PyTorch binding
torch::Tensor fused_rotation_quant_mfma(
    torch::Tensor x,          // [M, K] bf16
    torch::Tensor rotation,   // [RS, RS] bf16
    torch::Tensor fp4_out,    // [M, K/2] uint8
    torch::Tensor scale_out,  // [sm, sn] or [M, K/32] uint8
    int rotation_size,
    int shuffle_scales
) {
    int M = x.size(0);
    int K = x.size(1);
    int sn_padded = scale_out.size(1);
    
    dim3 grid((M + BLOCK_M - 1) / BLOCK_M, K / rotation_size);
    dim3 block(THREADS);
    
   hipLaunchKernelGGL(( fused_rotation_quant_mfma_kernel), dim3(grid), dim3(block), 0, at::hip::getCurrentHIPStream(), 
        fp4_out.data_ptr<uint8_t>(),
        scale_out.data_ptr<uint8_t>(),
        (const __bf16*)x.data_ptr(),
        (const __bf16*)rotation.data_ptr(),
        M, K,
        K,       // stride_x_m
        K / 2,   // stride_fp4_m
        sn_padded, // stride_sc_m
        sn_padded,
        shuffle_scales
    );
    
    return fp4_out;
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("fused_rotation_quant_mfma", &fused_rotation_quant_mfma,
          "Fused rotation + MXFP4 quant with MFMA (HIP)");
}
